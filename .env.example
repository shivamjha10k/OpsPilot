APP_NAME=OpsPilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://opspilot:change-me-local-only@postgres:5432/opspilot
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=opspilot_knowledge
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSION=64
EMBEDDING_TIMEOUT_SECONDS=10
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_RESULTS=10
RAG_MAX_CONTEXT_CHARS=12000
MAX_SIMULATED_REPLICAS=20
MAX_SIMULATED_WORKERS=50
TOOL_EXECUTION_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
APPROVAL_EXPIRATION_MINUTES=60
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INCIDENT_CORRELATION_WINDOW_MINUTES=5
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_SECONDS=1
SIMULATOR_RANDOM_SEED=20260908
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_SOFT_TIME_LIMIT=60
CELERY_TASK_TIME_LIMIT=120
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_TOOL_CALLS=5
AI_MAX_INVESTIGATION_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_ALERTS=20
AI_MAX_EVENTS=50
AI_MAX_LOGS=50
AI_MAX_METRIC_POINTS=100
AI_MAX_DEPLOYMENTS=20
AI_MAX_CONTEXT_CHARS=50000
AI_PROMPT_VERSION=v1
DEV_ADMIN_EMAIL=admin@opspilot.local
DEV_ADMIN_PASSWORD=change-me-admin
DEV_ENGINEER_EMAIL=engineer@opspilot.local
DEV_ENGINEER_PASSWORD=change-me-engineer
DEV_VIEWER_EMAIL=viewer@opspilot.local
DEV_VIEWER_PASSWORD=change-me-viewer
